# LLM provider (Groq — https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database (SQLite by default — persistent file on disk)
DATABASE_URL=sqlite:///./agentcare.db

# Session / cookie signing secret — generate your own random string for real deployments
SESSION_SECRET=change_this_to_a_random_secret_string

# App
APP_ENV=development
LOG_LEVEL=INFO
